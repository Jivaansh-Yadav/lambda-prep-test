# Security headers. These are also applied by src/server.ts (the SSR entry), so
# this block matters only on hosts that read `_headers` (Cloudflare Pages /
# Netlify). Keep the two in sync — the CSP here must stay identical to
# CONTENT_SECURITY_POLICY in src/server.ts.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.eazo.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.eazo.ai https://assets.eazo.ai https://drive.google.com; media-src 'self' blob: https://mscontent-gcp.extramarks.com; connect-src 'self' https://mscontent-gcp.extramarks.com https://eazo.ai https://cdn.eazo.ai; frame-src 'self' https://drive.google.com https://docs.google.com https://mscontent-gcp.extramarks.com; worker-src 'self' blob:; frame-ancestors 'self'; form-action 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OG image, favicon and logo rarely change but aren't content-hashed, so use
# a long max-age with revalidation instead of `immutable` — a new deploy with
# the same filename will still be picked up once the cache expires/revalidates.
/og/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/lambda-logo.svg
  Cache-Control: public, max-age=604800, must-revalidate

# Hero photograph, also served straight out of public/ (see src/lib/brand.ts).
/student-studying.jpg
  Cache-Control: public, max-age=604800, must-revalidate

# robots.txt / sitemap.xml are crawled frequently and can change (new
# routes), so keep them revalidating on every request rather than cached.
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
