/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OG image, favicon and logo rarely change but aren't content-hashed, so use
# a long max-age with revalidation instead of `immutable` — a new deploy with
# the same filename will still be picked up once the cache expires/revalidates.
/og/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/lambda-logo.svg
  Cache-Control: public, max-age=604800, must-revalidate

# robots.txt / sitemap.xml are crawled frequently and can change (new
# routes), so keep them revalidating on every request rather than cached.
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
